{
  "regions": ["gru1"],
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
